{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kovera.tech/schemas/kovera-delegation-chain/1",
  "$comment": "Wave 2.1 — portable multi-agent delegation provenance. HDP-style signed hop proof + ADCS v0.1 aligned links[].",
  "title": "Kovera Delegation Chain v1",
  "description": "Open schema for agent-to-agent delegation chains with human origin invariant, monotonic scope narrowing, and offline-verifiable HDP hop proofs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "chain_id",
    "issued_at",
    "origin",
    "links",
    "depth",
    "invariants",
    "proof"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "kovera-delegation-chain/1"
    },
    "chain_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identifier for this delegation chain document."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the chain document was sealed."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_sub", "origin_invariant"],
      "description": "Human principal at chain root — MUST NOT change across hops (ADCS originSub invariant).",
      "properties": {
        "origin_sub": {
          "type": "string",
          "description": "Stable human principal identifier (OIDC sub, workforce ID, etc.). Maps to ADCS originSub."
        },
        "origin_claims": {
          "type": "object",
          "description": "Optional claims snapshot at chain creation. Maps to ADCS originClaims.",
          "additionalProperties": true
        },
        "origin_invariant": {
          "type": "string",
          "const": "immutable"
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered delegation hops. links[0] is first agent; links[N-1] is current agent. ADCS-aligned.",
      "items": {
        "$ref": "#/$defs/delegation_link"
      }
    },
    "depth": {
      "type": "integer",
      "minimum": 1,
      "description": "MUST equal links.length (ADCS depth)."
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_sub_immutable", "scope_monotonic_narrowing", "human_origin_required"],
      "properties": {
        "origin_sub_immutable": { "type": "boolean", "const": true },
        "scope_monotonic_narrowing": { "type": "boolean", "const": true },
        "human_origin_required": { "type": "boolean", "const": true }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "hop_schema", "signature_alg", "hop_count", "hops"],
      "description": "HDP-style signed hop chain bound to links[].",
      "properties": {
        "profile": {
          "type": "string",
          "const": "kovera.hdp-hop-chain/v1"
        },
        "hop_schema": {
          "type": "string",
          "const": "kovera.hdp-hop-receipt/v1"
        },
        "signature_alg": {
          "type": "string",
          "enum": ["HMAC-SHA256"]
        },
        "hop_count": { "type": "integer", "minimum": 1 },
        "chain_root_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "chain_tip_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "hops": {
          "type": "array",
          "items": { "$ref": "#/$defs/hdp_hop_receipt" }
        }
      }
    },
    "adcs_alignment": {
      "type": "object",
      "description": "Interop metadata for ADCS v0.1 procurement reviews.",
      "properties": {
        "profile": { "type": "string", "const": "ADCS-v0.1" },
        "mapping_version": { "type": "string" },
        "reference": { "type": "string", "format": "uri" },
        "conformant_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verified": { "type": "boolean" },
    "verification_code": { "type": "string" }
  },
  "$defs": {
    "delegation_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hop_index",
        "agent_profile_id",
        "agent_run_id",
        "agent_name",
        "session_id",
        "effective_scopes",
        "effective_tools",
        "scope_hash",
        "remaining_budget_cents",
        "delegated_at"
      ],
      "properties": {
        "hop_index": { "type": "integer", "minimum": 0 },
        "agent_profile_id": {
          "type": "string",
          "description": "Stable agent type ID. ADCS agentProfileId."
        },
        "agent_run_id": {
          "type": "string",
          "description": "Unique per-invocation run ID. ADCS agentRunId."
        },
        "agent_name": { "type": "string", "description": "ADCS agentName." },
        "session_id": { "type": "string", "description": "Kovera governed session binding." },
        "parent_session_id": { "type": ["string", "null"] },
        "parent_agent_run_id": {
          "type": ["string", "null"],
          "description": "ADCS parentAgentRunId for hop > 0."
        },
        "effective_scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ADCS effectiveScopes — MUST narrow monotonically."
        },
        "effective_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ADCS effectiveTools — MUST narrow monotonically."
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of sorted effective_scopes + effective_tools."
        },
        "remaining_budget_cents": {
          "type": "integer",
          "minimum": 0,
          "description": "ADCS remainingBudgetCents — child MUST NOT exceed parent."
        },
        "delegated_at": {
          "type": "string",
          "format": "date-time",
          "description": "ADCS delegatedAt."
        }
      }
    },
    "hdp_hop_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "hop_index",
        "session_id",
        "issued_at",
        "hop_hash",
        "signature_alg",
        "signature"
      ],
      "properties": {
        "schema": { "type": "string", "const": "kovera.hdp-hop-receipt/v1" },
        "hop_index": { "type": "integer", "minimum": 0 },
        "session_id": { "type": "string" },
        "parent_session_id": { "type": ["string", "null"] },
        "parent_hop_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "scope_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "agent_id": { "type": ["string", "null"] },
        "passport_jti": { "type": ["string", "null"] },
        "issued_at": { "type": "string", "format": "date-time" },
        "hop_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signature_alg": { "type": "string", "enum": ["HMAC-SHA256"] },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "adcs_field_mapping": {
      "$comment": "Normative mapping kovera-delegation-chain/1 → ADCS v0.1",
      "origin.origin_sub": "originSub",
      "origin.origin_claims": "originClaims",
      "links[].agent_profile_id": "agentProfileId",
      "links[].agent_run_id": "agentRunId",
      "links[].agent_name": "agentName",
      "links[].effective_scopes": "effectiveScopes",
      "links[].effective_tools": "effectiveTools",
      "links[].remaining_budget_cents": "remainingBudgetCents",
      "links[].delegated_at": "delegatedAt",
      "links[].parent_agent_run_id": "parentAgentRunId",
      "depth": "depth"
    }
  }
}
